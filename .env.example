# =================================================================
# GoMate Platform Environment Configuration Template
# =================================================================

# Server Port
PORT=3000

# Admin Dashboard Passkey (used for http://localhost:3000/admin)
ADMIN_PASSWORD=gomate2026

# Twilio WhatsApp API Credentials (for Cloud / Sandbox messaging)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Google Gemini AI Key (for natural language query assistant)
GEMINI_API_KEY=your_gemini_api_key

# Supabase PostgreSQL Cloud Database
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
SUPABASE_ANON_KEY=your_supabase_anon_key

# Razorpay UPI / Cards Payment Gateway (for ₹599/mo Owner Subscriptions)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Optional: Public Render or Cloud Tunnel Base URL
RENDER_EXTERNAL_URL=https://gomate-whatsapp-bot.onrender.com
