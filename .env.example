# Server Port
PORT=3000

# Admin Dashboard Passkey (used for http://localhost:3000/admin)
ADMIN_PASSWORD=gomate2026

# 🌟 Meta WhatsApp Cloud API (Official WhatsApp Business API)
META_PHONE_NUMBER_ID=your_meta_phone_number_id
META_ACCESS_TOKEN=your_meta_permanent_system_user_access_token
META_VERIFY_TOKEN=gomate_meta_token_2026
META_WABA_ID=your_whatsapp_business_account_id

# Twilio WhatsApp API Credentials (Legacy / Optional)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
