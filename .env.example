# =================================================================
# GoMate Platform Environment Configuration Template
# =================================================================

# Server Port
PORT=3000

# Admin Dashboard Access (required in Render before the admin dashboard can be used)
# Use a unique passphrase. Never use a value from this example in production.
ADMIN_PASSWORD=replace_with_a_long_unique_admin_passphrase
# Generate a unique 32+ character value, for example: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=replace_with_a_64_character_random_secret

# Twilio WhatsApp API Credentials (for Cloud / Sandbox messaging)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Google Gemini AI Key (for natural language query assistant)
GEMINI_API_KEY=your_gemini_api_key

# Supabase PostgreSQL Cloud Database
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
SUPABASE_ANON_KEY=your_supabase_anon_key

# Razorpay UPI / Cards Payment Gateway (for ₹599/mo Owner Subscriptions)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Optional: Public Render or Cloud Tunnel Base URL
RENDER_EXTERNAL_URL=https://gomate-whatsapp-bot.onrender.com
